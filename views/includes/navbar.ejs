<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;

    display: inline-flex;
    align-items: center;
    gap: .5rem;
  }

  .search-btn:hover {
    background-color: #fe424d;
  }

  .search-imp {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid d-flex align-items-center">
    <!-- LEFT -->
    <div class="d-flex align-items-center flex-grow-1">
      <a class="navbar-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <a class="nav-link" href="/listings">Explore</a>
    </div>

    <!-- CENTER -->
    <div class="flex-shrink-0">
      <form class="d-flex" role="search" method="post" action="listings/eamam">
        <input class="form-control me-2 search-imp" type="search" placeholder="Search destination" />
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </form>
    </div>

    <!-- RIGHT -->
    <div class="d-flex align-items-center flex-grow-1 justify-content-end">
      <a class="nav-link me-2" href="/listings/new">Airbnb your home</a>
      <% if(!currentUser) { %>
      <a class="nav-link me-2" href="/signup"><b>Sign up</b></a>
      <a class="nav-link " href="/login"><b>Log in</b></a>
      <% } else { %>
      <a class="nav-link" href="/logout"><b>Log out</b></a>
      <% } %>
    </div>
  </div>
</nav>
